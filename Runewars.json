    "sharedRules": [
      {
        "name": "Impact [X]",
        "id": "3acc-998c-be8b-5314",
        "description": "When a unit with this keyword collides with an enemy unit during a charge, that unit recives X panic tokens.",
        "hidden": false
      },
      {"name": "Brutal [X]", "id": "4bc3-5a1a-a748-31de", "description": "While attacking, a unit with this keyword has its threat increased by X.", "hidden": false},
      {
        "name": "Precise [X]",
        "id": "4309-11a6-e7f5-5a76",
        "description": "When rerolling dice during an attack, a unit with this keyword is treated as having X additional full rank of trays.",
        "hidden": false
      },
      {
        "name": "Steadfast [X]",
        "id": "94ec-3f37-454f-92ad",
        "description": "While a unit with this keyword is suffering a morale test, the cards of the type specified by X are treated as having one additional morale icon.",
        "hidden": false
      },
      {
        "name": "Regenerate [X]",
        "id": "aa91-b501-7649-91ea",
        "description": "At the end of the Activation Phase, if a unit with this keyword has any empty slots in its trays, slot X new figures corresponding with that unit's card in the empty slots.",
        "hidden": false
      },
      {
        "name": "Resillient [X]",
        "id": "8d09-61a0-2bab-847a",
        "description": "If a unit with this keyword would receive the bane specifed by X, the unit does not recieve that bane.",
        "hidden": false
      },
      {
        "name": "Protector",
        "id": "d922-50db-76e7-150a",
        "description": "Allies engaged with an enemy you are also engaged with and allies at range 1-2 cannot be targeted by attacks if that attack could target a unit with protector.",
        "hidden": false
      },
      {"name": "Lethal [X]", "id": "4734-4adc-bba1-0b47", "description": "While attacking, add [X] to the damage pool.", "hidden": false},
      {"name": "Protected [X]", "id": "4b78-f83c-2b4b-61a6", "description": "While defending, subtract [X] from the damage pool.", "hidden": false},
      {
        "name": "Scout",
        "id": "6221-2275-02d3-4099",
        "description": "Deploy after the \"Deploy Units\" step of setup. You may then perform any blue action and matching modifier.",
        "hidden": false
      }
